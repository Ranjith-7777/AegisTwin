# Reference values used by START_AEGISTWIN_DEMO.bat (scripts/demo/start_aegistwin_demo.ps1).
# The launcher exports these itself; this file documents them and is not read.
AEGISARENA_DISABLE_DOTENV=1
ENVIRONMENT=demo
DEMO_MODE=true
SIMULATION_ONLY=true
AUTH_DEV_BYPASS_ROLE=ADMIN
DATABASE_URL=sqlite:///./.aegistwin-demo/data/aegistwin-demo.db
MODEL_ARTIFACT_DIR=.aegistwin-demo/model-artifacts
CORS_ORIGINS=http://127.0.0.1:5173,http://localhost:5173
LOG_LEVEL=INFO
VITE_API_BASE_URL=http://127.0.0.1:8000
VITE_WS_BASE_URL=ws://127.0.0.1:8000
VITE_DEMO_MODE=true
VITE_DEPLOYMENT_ENV=local-demo
