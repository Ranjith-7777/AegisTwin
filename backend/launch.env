# Local development launch profile (.claude/launch.json, run from the repo root).
# Every value the dev server depends on is set here explicitly; the untracked
# backend/.env is ignored so behaviour is reproducible on any machine.
AEGISARENA_DISABLE_DOTENV=1
ENVIRONMENT=development
DEBUG=false
DATABASE_URL=sqlite:///backend/aegistwin.db
# Relative paths are anchored to backend/ (see app/core/config.py).
MODEL_ARTIFACT_DIR=artifacts/models
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
SIMULATION_ONLY=true
LOG_LEVEL=INFO
# Local dev only: grants every request ADMIN without a real sign-in.
# Hard-blocked in production by backend/app/core/config.py.
AUTH_DEV_BYPASS_ROLE=ADMIN
