# Configuration only: no secrets belong in this file or in any .env file
# committed to the repository. This deployment has no external API tokens,
# database credentials, or cloud credentials today (SQLite is a local file,
# not a credentialed service) - see docs/architecture/adr/ADR-003-sqlite-phase-1.md.
# A future Azure deployment would source secrets (e.g. a managed database
# connection string) from Azure Key Vault at deploy time, injected as
# environment variables at container/process startup - never committed here.
APP_NAME=AegisArena API
ENVIRONMENT=development
DEBUG=true
API_PREFIX=/api
BACKEND_HOST=127.0.0.1
BACKEND_PORT=8000
DATABASE_URL=sqlite:///./aegistwin.db
CORS_ORIGINS=http://localhost:5173
LOG_LEVEL=INFO
SIMULATION_ONLY=true
MODEL_ARTIFACT_DIR=artifacts/models
# Local development only. Production examples use explicit HTTPS origins and DEBUG=false.

