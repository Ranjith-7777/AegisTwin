APP_NAME=AegisArena API
ENVIRONMENT=development
DEBUG=true
API_PREFIX=/api
BACKEND_HOST=127.0.0.1
BACKEND_PORT=8000
DATABASE_URL=sqlite:///./aegistwin.db
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
LOG_LEVEL=INFO
SIMULATION_ONLY=true
# Local development only: treat every request as this role (VIEWER, ANALYST or
# ADMIN) without a real sign-in. Without it, unauthenticated callers are
# read-only VIEWERs and every write returns 403. The backend refuses to start
# if this is set together with ENVIRONMENT=production.
AUTH_DEV_BYPASS_ROLE=ADMIN
